# Lambda Function URL (no trailing slash)
VITE_API_BASE_URL=https://your-function-url.lambda-url.ap-south-1.on.aws

# S3 outputs bucket public URL (no trailing slash)
VITE_OUTPUTS_BASE_URL=https://labelcheck-outputs.s3.ap-south-1.amazonaws.com

# Polling interval in ms (default 2000)
VITE_POLL_INTERVAL_MS=2000
